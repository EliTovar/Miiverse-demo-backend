# Copia este archivo como .env y rellena los valores. .env NO se sube a git.

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL (solo DB_PASSWORD es obligatoria; el resto tiene esos valores por defecto)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=SocialMedia

# URL pública del backend (la usan los servicios del proxy de imágenes)
BASE_URL=http://localhost:3000

# Google Gemini (asistente de IA del panel admin)
GEMINI_API_KEY=
